# Copy to .env and fill in. .env is ignored by git.
#
# On Linux or macOS:   export $(grep -v '^#' .env | xargs) && ./mvnw spring-boot:run
# On Windows PowerShell, set the variables with $env:NAME = "value" before running.

# Database
DB_URL=jdbc:mysql://localhost:3306/medical_on_time?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Signing key for access tokens. At least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=120

# Where the frontend is served from. Comma separated for more than one.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# First admin account, created once on an empty database.
# Leave the password blank and one is generated and printed to the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
